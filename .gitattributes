# Normalize text files and store them consistently in Git.
* text=auto

# Cross-platform source, configuration, documentation, and patch files use LF.
.gitattributes text eol=lf
.gitignore text eol=lf
Makefile text eol=lf
*.mk text eol=lf
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.patch text eol=lf

# Native Windows scripts use CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files must never be modified by line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.ppt binary
*.pptx binary
*.doc binary
*.docx binary
*.zip binary
*.gz binary
*.tar binary
*.exe binary
*.dll binary
*.o binary
