{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pair13/finding-report-v2.schema.json",
  "title": "Pair13 MD/RD finding report v2.0 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","report_id","repository","configuration_id","environment","detector","provenance","findings"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "report_id": {"type": "string","minLength": 1},
    "repository": {
      "type": "object","additionalProperties": false,"required": ["url","commit"],
      "properties": {
        "url": {"type": "string","minLength": 1},
        "commit": {"type": "string","pattern": "^[0-9a-fA-F]{40}$"}
      }
    },
    "configuration_id": {"type": "string","minLength": 1},
    "environment": {
      "type": "object","additionalProperties": false,"required": ["os","arch"],
      "properties": {
        "os": {"type": "string","minLength": 1},
        "arch": {"type": "string","minLength": 1},
        "make_version": {"type": "string","minLength": 1},
        "cc_version": {"type": "string","minLength": 1},
        "image_ref": {"type": "string","minLength": 1}
      }
    },
    "detector": {"enum": ["BUILDCHECKER","ECHECKER","INSTRUCTOR_ORACLE","A13_MANUAL_ORACLE","B13_MANUAL_ORACLE"]},
    "provenance": {"type": "string","minLength": 1},
    "producer_job_id": {"type": ["string","null"],"pattern": "^job-[A-Za-z0-9-]+$"},
    "findings": {"type": "array","items": {"$ref": "#/$defs/finding"}},
    "artifact_locator": {"$ref": "#/$defs/artifactLocator"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "relativePath": {"type": "string","minLength": 1,"pattern": "^(?!/)(?!\\./)(?!.*\\\\).+"},
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^(a13|b13|pair13)\\.[A-Za-z0-9_.-]+$"},
      "additionalProperties": true
    },
    "resolvedLocation": {
      "type": "object","additionalProperties": false,"required": ["status","path","line"],
      "properties": {
        "status": {"const": "RESOLVED"},
        "path": {"$ref": "#/$defs/relativePath"},
        "line": {"type": "integer","minimum": 1},
        "declaration": {"type": "string","minLength": 1}
      }
    },
    "unresolvedLocation": {
      "type": "object","additionalProperties": false,"required": ["status","reason"],
      "properties": {
        "status": {"const": "UNRESOLVED"},
        "reason": {"type": "string","minLength": 1}
      }
    },
    "evidenceItem": {
      "type": "object","additionalProperties": false,"required": ["kind","detail"],
      "properties": {
        "kind": {"type": "string","minLength": 1},
        "detail": {"type": "string","minLength": 1},
        "uri": {"type": "string","pattern": "^artifact://pair13/"}
      }
    },
    "finding": {
      "type": "object","additionalProperties": false,
      "required": ["finding_id","type","target","dependency","location","evidence"],
      "properties": {
        "finding_id": {"type": "string","minLength": 1},
        "type": {"enum": ["MISSING","REDUNDANT"]},
        "target": {"type": "string","minLength": 1},
        "dependency": {"$ref": "#/$defs/relativePath"},
        "commit": {"type": "string","pattern": "^[0-9a-fA-F]{40}$"},
        "configuration_id": {"type": "string","minLength": 1},
        "location": {"oneOf": [{"$ref": "#/$defs/resolvedLocation"},{"$ref": "#/$defs/unresolvedLocation"}]},
        "evidence": {"type": "array","minItems": 1,"items": {"$ref": "#/$defs/evidenceItem"}},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "artifactLocator": {
      "type": "object","additionalProperties": false,
      "required": ["uri","repository_url","repository_commit","repository_path","sha256"],
      "properties": {
        "uri": {"type": "string","pattern": "^artifact://pair13/"},
        "repository_url": {"type": "string","minLength": 1},
        "repository_commit": {"type": "string","pattern": "^[0-9a-fA-F]{40}$"},
        "repository_path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"type": "string","pattern": "^[0-9a-fA-F]{64}$"}
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"detector": {"enum": ["BUILDCHECKER","ECHECKER"]}},"required": ["detector"]},
    "then": {"required": ["producer_job_id"],"properties": {"producer_job_id": {"type": "string","pattern": "^job-[A-Za-z0-9-]+$"}}},
    "else": {"properties": {"producer_job_id": {"type": "null"}}}
  }]
}