{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A13 dependency finding report",
  "type": "object",
  "required": ["schema_version", "repository", "configuration_id", "producer_job_id", "findings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "repository": {
      "type": "object",
      "required": ["url", "commit"],
      "properties": {
        "url": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
      }
    },
    "configuration_id": {"type": "string"},
    "producer_job_id": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "type", "target", "dependency", "commit", "configuration_id", "location", "evidence"],
        "properties": {
          "finding_id": {"type": "string"},
          "type": {"enum": ["MISSING", "REDUNDANT"]},
          "target": {"type": "string"},
          "dependency": {"type": "string"},
          "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
          "configuration_id": {"type": "string"},
          "location": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {"enum": ["RESOLVED", "UNRESOLVED"]},
              "path": {"type": "string"},
              "line": {"type": "integer", "minimum": 1},
              "reason": {"type": "string"}
            }
          },
          "evidence": {"type": "array", "minItems": 1}
        }
      }
    }
  },
  "additionalProperties": true
}
