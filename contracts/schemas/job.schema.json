{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/b13/job.schema.json",
  "title": "B13/A13 Job snapshot (provisional)",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "trace_id",
    "job_type",
    "status",
    "input",
    "output",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job-[A-Za-z0-9-]+$"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "job_type": {
      "enum": [
        "DRAFT",
        "FULL_CHECK",
        "INCREMENTAL_CHECK",
        "REPAIR"
      ]
    },
    "status": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "CANCELLED"
      ]
    },
    "input": {
      "type": "object",
      "minProperties": 1
    },
    "output": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "log_uri": {
          "type": "string",
          "pattern": "^artifact://"
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "QUEUED",
              "RUNNING"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "output": {
            "type": "null"
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUCCEEDED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "output": {
            "type": "object"
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "FAILED",
              "TIMED_OUT",
              "CANCELLED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "output": {
            "type": "null"
          },
          "error": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "job_type": {
            "const": "DRAFT"
          }
        },
        "required": [
          "job_type"
        ]
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "required": [
              "repository",
              "context_files",
              "build",
              "max_iterations",
              "configuration_id"
            ],
            "properties": {
              "repository": {
                "type": "object",
                "required": [
                  "url",
                  "commit"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "commit": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{40}$"
                  }
                }
              },
              "context_files": {
                "type": "array",
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "build": {
                "type": "object",
                "required": [
                  "command",
                  "verify_command",
                  "timeout_seconds",
                  "expected_stdout",
                  "clean_command",
                  "working_directory"
                ],
                "properties": {
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verify_command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "timeout_seconds": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "expected_stdout": {
                    "type": "string"
                  },
                  "clean_command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "working_directory": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "max_iterations": {
                "type": "integer",
                "minimum": 1
              },
              "configuration_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "job_type": {
            "const": "DRAFT"
          },
          "status": {
            "const": "SUCCEEDED"
          }
        },
        "required": [
          "job_type",
          "status"
        ]
      },
      "then": {
        "properties": {
          "output": {
            "type": "object",
            "required": [
              "image_ref",
              "image_id",
              "build_exit_code",
              "verify_exit_code",
              "verify_stdout",
              "environment",
              "iterations",
              "artifacts"
            ],
            "properties": {
              "image_ref": {
                "type": "string",
                "minLength": 1
              },
              "image_id": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "build_exit_code": {
                "type": "integer",
                "const": 0
              },
              "verify_exit_code": {
                "type": "integer",
                "const": 0
              },
              "verify_stdout": {
                "type": "string"
              },
              "environment": {
                "type": "object",
                "required": [
                  "os",
                  "arch",
                  "project_root",
                  "working_directory",
                  "clean_build_command",
                  "configuration_id",
                  "repository_commit",
                  "tracking"
                ],
                "properties": {
                  "os": {
                    "const": "linux"
                  },
                  "arch": {
                    "type": "string",
                    "minLength": 1
                  },
                  "project_root": {
                    "type": "string",
                    "minLength": 1
                  },
                  "working_directory": {
                    "type": "string",
                    "minLength": 1
                  },
                  "clean_build_command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "configuration_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "repository_commit": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{40}$"
                  },
                  "tracking": {
                    "type": "object",
                    "required": [
                      "status",
                      "required_capabilities",
                      "security_options"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "PENDING_A13",
                          "CONFIRMED"
                        ]
                      },
                      "required_capabilities": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "security_options": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "status": {
                              "const": "CONFIRMED"
                            }
                          },
                          "required": [
                            "status"
                          ]
                        },
                        "then": {
                          "properties": {
                            "required_capabilities": {
                              "type": "array"
                            },
                            "security_options": {
                              "type": "array"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "iterations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "iteration",
                    "build_exit_code",
                    "log_uri",
                    "change_description"
                  ],
                  "properties": {
                    "iteration": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "build_exit_code": {
                      "type": "integer"
                    },
                    "log_uri": {
                      "type": "string",
                      "pattern": "^artifact://pair13/"
                    },
                    "change_description": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "artifacts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "title": "B13/A13 Artifact metadata (provisional)",
                  "type": "object",
                  "required": [
                    "artifact_id",
                    "type",
                    "uri",
                    "media_type",
                    "producer_job_id",
                    "repository_commit",
                    "configuration_id"
                  ],
                  "properties": {
                    "artifact_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uri": {
                      "type": "string",
                      "pattern": "^artifact://pair13/"
                    },
                    "media_type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "producer_job_id": {
                      "type": "string",
                      "pattern": "^job-[A-Za-z0-9-]+$"
                    },
                    "repository_commit": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{40}$"
                    },
                    "configuration_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{64}$"
                    }
                  },
                  "additionalProperties": true
                },
                "contains": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "DOCKERFILE"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
