{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/b13/create-job.schema.json",
  "title": "B13/A13 create-job request (provisional)",
  "type": "object",
  "required": ["schema_version", "trace_id", "job_type", "idempotency_key", "input"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "job_type": {"enum": ["DRAFT", "FULL_CHECK", "INCREMENTAL_CHECK", "REPAIR"]},
    "idempotency_key": {"type": "string", "minLength": 1},
    "input": {"type": "object", "minProperties": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"job_type": {"const": "INCREMENTAL_CHECK"}}, "required": ["job_type"]},
      "then": {
        "properties": {
          "input": {
            "required": ["repository", "base_commit", "baseline"],
            "properties": {
              "base_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
              "baseline": {
                "type": "object",
                "required": ["actual_graph_uri", "commit", "configuration_id"],
                "properties": {
                  "actual_graph_uri": {"type": "string", "pattern": "^artifact://"},
                  "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
                  "configuration_id": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
